rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true si el usuario autenticado es el trainer vinculado a userId
    // La subcolección clients vive bajo el documento del trainer:
    //   users/{trainerId}/clients/{clientId}
    function isTrainerOf(userId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/clients/$(userId));
    }

    // Helper: true si el usuario autenticado es el cliente cuyo trainer es userId
    // Útil para que el cliente lea el perfil de su propio trainer
    function isClientOf(userId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(userId)/clients/$(request.auth.uid));
    }

    // =====================================================================
    // FOTOS DE PERFIL
    // =====================================================================
    match /profile_photos/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read:  if request.auth != null;
    }

    // =====================================================================
    // USUARIOS
    // =====================================================================
    match /users/{userId} {

      // El propio usuario gestiona su documento
      allow get, create, update, delete: if request.auth != null && request.auth.uid == userId;

      // El trainer puede leer el documento de sus clientes vinculados
      allow get: if isTrainerOf(userId);

      // El cliente puede leer el perfil de su trainer
      allow get: if isClientOf(userId);

      // Query .whereEqualTo("linkedTrainerUid", trainerId) — Firestore evalúa por documento
      allow list: if request.auth != null
                  && resource.data.linkedTrainerUid == request.auth.uid;

      // El trainer puede desactivar/desvincular a un cliente (removeClient)
      allow update: if request.auth != null
                    && resource.data.linkedTrainerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['linkedTrainerUid', 'isActive']);

      // =================================================================
      // SUBCOLECCIÓN: clients  (lista de clientes del trainer)
      // =================================================================
      match /clients/{clientId} {
        // El trainer gestiona su propia lista
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
        // El cliente puede añadirse a sí mismo al aceptar una invitación
        allow create: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == clientId);
      }

      // =================================================================
      // SUBCOLECCIÓN: bodyStats
      // =================================================================
      match /bodyStats/{bodyStatsId} {
        allow read, write, create, update, delete: if request.auth != null && request.auth.uid == userId;
        allow read: if isTrainerOf(userId);
      }

      // =================================================================
      // SUBCOLECCIÓN: workoutEntries
      // =================================================================
      match /workoutEntries/{workoutId} {
        allow read, write, update, delete: if request.auth != null && request.auth.uid == userId;
        allow read: if isTrainerOf(userId);
      }

      // =================================================================
      // SUBCOLECCIÓN: exercises  (ejercicios personalizados del usuario)
      // =================================================================
      match /exercises/{exerciseId} {
        allow read, write, create, update, delete: if request.auth != null && request.auth.uid == userId;
        allow read: if isTrainerOf(userId);
      }

      // =================================================================
      // SUBCOLECCIÓN: routines
      // =================================================================
      match /routines/{routineId} {
        // El propio usuario o su trainer puede leer/escribir/borrar
        allow read, write, update, delete: if request.auth != null &&
          (request.auth.uid == userId || isTrainerOf(userId));

        // Crear rutina: el propio usuario o el trainer vinculado
        allow create: if request.auth != null &&
          (request.auth.uid == userId || isTrainerOf(userId));
      }

      // =================================================================
      // SUBCOLECCIÓN: sessions
      // =================================================================
      match /sessions/{sessionId} {
        allow read, write, create, update, delete: if request.auth != null && request.auth.uid == userId;
        allow read: if isTrainerOf(userId);
      }
    }

    // =====================================================================
    // EJERCICIOS GLOBALES (catálogo compartido)
    // =====================================================================
    match /exercises/{exerciseId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // =====================================================================
    // SUSCRIPCIONES
    // =====================================================================
    match /subscriptions/{userId} {
      allow read, write, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // =====================================================================
    // INVITACIONES
    // =====================================================================
    match /invitations/{invitationId} {
      // Cualquier autenticado puede leer (necesario para buscar el código)
      allow read: if request.auth != null;

      // Solo el trainer que la crea puede crear (trainerId debe coincidir)
      allow create: if request.auth != null &&
        request.resource.data.trainerId == request.auth.uid;

      // El trainer puede actualizar/eliminar sus propias invitaciones;
      // el cliente puede marcarla como usada al aceptar
      allow update: if request.auth != null &&
        (
          resource.data.trainerId == request.auth.uid ||
          (
            resource.data.isActive == true &&
            resource.data.usedBy == null &&
            request.resource.data.usedBy == request.auth.uid &&
            request.resource.data.isActive == false
          )
        );

      allow delete: if request.auth != null && resource.data.trainerId == request.auth.uid;
    }
  }
}
