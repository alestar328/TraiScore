<?xml version="1.0" encoding="utf-8"?>
<!-- Atributos PLATFORM (android:) para API 31+.
     El sistema Android crea la ventana del splash ANTES de que arranque cualquier código,
     leyendo directamente estos atributos del APK compilado.
     La librería core-splashscreen mapea los atributos compat → platform, pero ese mapeo
     llega tarde para la ventana inicial. Aquí los declaramos explícitamente. -->
<resources>

    <style name="Theme.TraiScore.NoSplash" parent="Theme.SplashScreen">
        <!-- Compat attrs (core-splashscreen, funciona en API 23+) -->
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.TraiScore</item>

        <!-- Platform attrs (leídos por el sistema en API 31+ antes de que arranque el proceso) -->
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>

        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

</resources>
